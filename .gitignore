.env
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
mlruns/
.DS_Store

# Derived zones: ignore contents, keep the folder via .gitkeep
data/staging/*
data/curated/*
!data/staging/.gitkeep
!data/curated/.gitkeep

# Large, regenerable OSM graphs
data/raw/road_network/*.graphml

# METR-LA benchmark download (large, regenerable)
data/raw/metr_la/

# Regenerable by `python -m src.benchmark.run` (13 MB binary)
reports/benchmark/models/*.pkl
!reports/benchmark/models/.gitkeep
